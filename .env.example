# Sao chép file này thành .env rồi điền khoá thật:  cp .env.example .env
#
# Lấy khoá tại https://openrouter.ai/keys
# Toàn bộ lời gọi LLM của ViCiRAG đi qua OpenRouter (giao thức OpenAI-compatible),
# nên chỉ cần một khoá duy nhất cho mọi model.
OPENROUTER_API_KEY=sk-or-v1-...

# Tuỳ chọn: đặt model mặc định (có thể ghi đè bằng cờ --llm-name)
# VICIRAG_LLM=google/gemini-2.5-flash
